(set-option :produce-unsat-cores true)
(set-option :auto_config false)
(set-option :smt.mbqi false)
(declare-fun Q (Int) Bool)
(declare-fun R (Int) Bool)
(declare-fun f (Int) Int)
(declare-fun g (Int) Int)
(declare-fun a () Int)
(declare-fun id1 () Bool)
(declare-fun id2 () Bool)
(declare-fun id3 () Bool)
(declare-fun id4 () Bool)
(assert (! id1 :named aux$$id1))
(assert (=> id1 (forall ((x Int)) (! (Q (f x)) :pattern ((g x))))))
(assert (! id2 :named aux$$id2))
(assert (=> id2 (forall ((y Int)) (! (R y) :pattern ((f y))))))
(assert (! id3 :named aux$$id3))
(assert (=> id3 (> (g a) 0)))
(assert (! id4 :named aux$$id4))
(assert (=> id4 (Q 7)))
(assert (not (R a)))
(check-sat)
(get-unsat-core)
