FROM codercom/code-server:latest

# Custom ProofPulse Dafny build (4.11.1 + --no-abstract-interpretation + {:id} passification fix)
ARG DAFNY_ZIP_URL="https://github.com/VeriFixer/dafny_proofpulse/releases/download/v0.1.0-proofpulse/dafny-0.1.0-proofpulse-x64-ubuntu-22.04.zip"
USER root

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget unzip libicu-dev ca-certificates python3 curl git \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Suppress npm update notices
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# Install Dafny (custom ProofPulse build) — zip is self-contained (includes .NET runtime)
RUN wget -q "$DAFNY_ZIP_URL" -O /tmp/dafny.zip \
    && unzip -q /tmp/dafny.zip -d /opt \
    && rm /tmp/dafny.zip \
    && ln -s /opt/dafny/dafny /usr/local/bin/dafny

# Install Z3 4.12.1 explicitly (Dafny-recommended version)
RUN wget -q "https://github.com/Z3Prover/z3/releases/download/z3-4.12.1/z3-4.12.1-x64-glibc-2.35.zip" -O /tmp/z3.zip \
    && unzip -q /tmp/z3.zip -d /tmp/z3-extract \
    && cp /tmp/z3-extract/z3-4.12.1-x64-glibc-2.35/bin/z3 /usr/local/bin/z3 \
    && chmod +x /usr/local/bin/z3 \
    && rm -rf /tmp/z3.zip /tmp/z3-extract

# Sanity-check both binaries work at build time
RUN dafny --version && z3 --version

# Copy project
WORKDIR /home/coder/project
COPY --chown=coder:coder . .

# Install deps and build everything including .vsix
RUN npm ci --ignore-scripts \
    && npm run build:core \
    && npm run build:viewer \
    && cd vscode_extension && npm run package && cd .. \
    && chown -R coder:coder /home/coder/project

# Install extensions as coder user so they persist in the right location
USER coder

# Install ProofPulse extension
RUN code-server --install-extension /home/coder/project/vscode_extension/proofpulse-vscode-0.1.0.vsix

# Install Dafny extension from Open VSX (published since v3.4.1)
RUN code-server --install-extension dafny-lang.ide-vscode

# Configure Dafny extension to use pre-installed Dafny (skip its own download)
# and configure ProofPulse to point to the correct paths
RUN mkdir -p /home/coder/.local/share/code-server/User \
    && printf '{\n  "dafny.compilerPath": "/usr/local/bin/dafny",\n  "dafny.version": "4.11.1",\n  "dafny.preferredVersion": "4.11.1",\n  "proofpulse.dafnyPath": "/usr/local/bin/dafny",\n  "proofpulse.z3Path": "/usr/local/bin/z3"\n}\n' \
       > /home/coder/.local/share/code-server/User/settings.json

EXPOSE 8080

CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "--auth", "none", "/home/coder/project"]
