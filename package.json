{
  "name": "proofpulse",
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["core", "vscode_extension", "evaluation"],
  "scripts": {
    "build:core": "tsc --project core/tsconfig.json",
    "build:viewer": "node web_viewer/build-spans-provider.mjs",
    "build": "npm run build:core && npm run build:viewer",
    "start": "node web_viewer/server.js",
    "test": "node web_viewer/cli.js",
    "test:unit": "node --test tests/unit/web_viewer/report.test.js",
    "test:server": "node --test tests/unit/web_viewer/server.test.js",
    "test:property": "vitest --run --config vitest.config.ts",
    "test:bundle": "node --test tests/unit/web_viewer/bundle-viewer.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fast-check": "^3.22.0"
  }
}
